{
  "name": "ticketpilot",
  "version": "1.0.0",
  "description": "Multi-tenant customer support platform with human-reviewed AI assistance",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/dev.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx server/worker.ts",
    "evaluate": "node --import tsx evaluations/run.ts",
    "dev:web": "vite --host 0.0.0.0",
    "seed": "node --env-file-if-exists=.env --import tsx server/seed.ts",
    "load": "node --import tsx scripts/load.ts",
    "test:e2e": "playwright test",
    "lint": "prettier --check \"{server,client,tests,scripts,evaluations}/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"{server,client,tests,scripts,evaluations}/**/*.{ts,tsx,css}\"",
    "load:local": "node --import tsx scripts/load-local.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
