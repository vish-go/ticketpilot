# Copy to .env. Do not commit .env. Use URL-safe random passwords here.
# Leave empty for persistent embedded development (npm run dev).
# For external PostgreSQL: postgres://ticketpilot:PASSWORD@localhost:5432/ticketpilot
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-random-password
PORT=3000
APP_ORIGIN=http://localhost:3000
# Secure cookies require HTTPS in production. See docs/operations.md for local Compose.
NODE_ENV=development
# Enable only behind one trusted reverse proxy.
TRUST_PROXY=false
AI_PROVIDER=disabled
EMBEDDING_PROVIDER=disabled
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# local = deterministic extractive baseline; openai = external LLM, customer text leaves server.
OPENAI_API_KEY=
AI_MODEL=
# Optional cost estimates: set actual configured model rates, never guessed rates.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Optional development seed; use your own password, never a shared production account.
DEMO_EMAIL=demo@ticketpilot.local
DEMO_PASSWORD=
EMAIL_PROVIDER=disabled
EMAIL_FROM=Support <support@example.com>
RESEND_API_KEY=
INBOUND_WEBHOOK_SECRET=
